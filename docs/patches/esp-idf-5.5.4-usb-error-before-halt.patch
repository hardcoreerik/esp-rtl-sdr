From 63b468539f86f759ae1075ed277b2da65eccbdfe Mon Sep 17 00:00:00 2001
From: Tomas Rezucha <tomas.rezucha@espressif.com>
Date: Tue, 22 Sep 2026 15:41:44 +0200
Subject: [PATCH] fix(esp_hal_usb): Do not abort on pipe error without halt
 INTR

If a pipe has an error, it will be automatically halted.
However, the pipe error interrupt is fired before the halt completes.

Closes https://github.com/espressif/esp-idf/issues/19111
---
 components/hal/usb_dwc_hal.c | 1 -
 1 file changed, 1 deletion(-)

diff --git a/components/hal/usb_dwc_hal.c b/components/hal/usb_dwc_hal.c
index b20fe494341a..aefb99ca9a5c 100644
--- a/components/hal/usb_dwc_hal.c
+++ b/components/hal/usb_dwc_hal.c
@@ -516,7 +516,6 @@ usb_dwc_hal_chan_event_t usb_dwc_hal_chan_decode_intr(usb_dwc_hal_chan_t *chan_o
     Errors > Channel Halt Request > Transfer completed
     */
     if (chan_intrs & CHAN_INTRS_ERROR_MSK) {    //Note: Errors are uncommon, so we check against the entire interrupt mask to reduce frequency of entering this call path
-        HAL_ASSERT(chan_intrs & USB_DWC_LL_INTR_CHAN_CHHLTD);  //An error should have halted the channel
         //Store the error in hal context
         usb_dwc_hal_chan_error_t error;
         if (chan_intrs & USB_DWC_LL_INTR_CHAN_STALL) {
