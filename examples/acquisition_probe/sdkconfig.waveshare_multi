# Waveshare P4 rev1.x, built-in hub DEVICE route, externally powered dongles.
# Serial-only probe: the Hosyond display is not initialized.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_ESP_RTL_SDR_PROBE_RECEIVERS=2
CONFIG_ESP_RTL_SDR_PROBE_DURATION_MS=900000
