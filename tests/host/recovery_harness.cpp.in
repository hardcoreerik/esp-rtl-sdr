#include "esp_rtl_sdr_acquisition.h"
#include <cstdio>
#define RTL_LOGE(...) ((void)0)
#define RTL_LOGW(...) ((void)0)
struct esp_rtl_sdr_handle {
    void *bulk = reinterpret_cast<void *>(1), *dev = reinterpret_cast<void *>(2);
    bool ep_stall_recover = true, streaming = true, pause_resubmit = false;
    uint32_t ep_recoveries = 0, ep_recoveries_at_data = 0, live_urbs = 2;
    esp_rtl_sdr_state_t state = ESP_RTL_SDR_STATE_STREAMING;
};
static bool drained;
static int resumed, endpoint_calls;
static constexpr uint32_t kEpRecoverAttempts = 8;
static void acquisition_interrupt(esp_rtl_sdr_handle *, uint32_t) {}
static bool drain_live_urbs(esp_rtl_sdr_handle *h, unsigned, unsigned) {
    if (drained) h->live_urbs=0;
    return drained;
}
static void usb_host_endpoint_halt(void *, int) { ++endpoint_calls; }
static void usb_host_endpoint_flush(void *, int) { ++endpoint_calls; }
static void usb_host_endpoint_clear(void *, int) { ++endpoint_calls; }
static void bulk_resume(esp_rtl_sdr_handle *h) { ++resumed;h->live_urbs=3; }
// ACTUAL_RECOVERY
int main() {
    esp_rtl_sdr_handle h;drained=false;
    bulk_recover_stall(&h);
    if (resumed || endpoint_calls || h.live_urbs!=2 || h.streaming || h.state!=ESP_RTL_SDR_STATE_FAULT) {
        std::puts("FAIL recovery resumed or hid outstanding transfers after drain timeout");return 1;
    }
    h={};drained=true;resumed=endpoint_calls=0;
    bulk_recover_stall(&h);
    if (resumed!=1 || endpoint_calls!=3 || !h.streaming) return 1;
    h={};h.ep_recoveries=kEpRecoverAttempts;resumed=endpoint_calls=0;
    bulk_recover_stall(&h);
    if (resumed || h.streaming || h.state!=ESP_RTL_SDR_STATE_FAULT) return 1;
    return 0;
}
